# Neon (or any Postgres) connection string. postgresql:// is rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: enables Claude for /workflows/from-text (rule-based parser is used otherwise)
ANTHROPIC_API_KEY=
# Run worker threads inside the API process (set false if you run `python -m app.engine.worker` separately)
RUN_WORKER=true
WORKER_CONCURRENCY=8
# Multiply every wait duration by this factor. 1 = real time. 0.0000578 ~= "1 day" becomes 5 seconds (demo mode).
WAIT_TIME_SCALE=1
